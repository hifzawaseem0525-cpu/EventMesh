@'
# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.env
.env.*
!.env.example

# Node
node_modules/
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# Do not push ZIP files
*.zip

# Keep local submission folders out of GitHub
EventMesh_Internship_Submission/
EventMesh_Submission/
ZIP_Check/
'@ | Set-Content -Path .gitignore